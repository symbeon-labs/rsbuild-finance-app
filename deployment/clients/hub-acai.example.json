{
  "$schema": "../manifest.schema.json",
  "_note": "REFERENCE ONLY. This manifest does not provision infrastructure or prove standalone runtime support. Replace environment-variable names only through an approved deployment change; never commit secret values.",
  "schemaVersion": "1.0.0",
  "deploymentId": "hub-acai",
  "mode": "standalone",
  "identity": {
    "organizationSlug": "hub_acai",
    "displayName": "Hub Açaí"
  },
  "controlPlane": {
    "mode": "disabled"
  },
  "capabilities": {
    "finance": true,
    "reconciliation": false,
    "logistics": true,
    "audit": true
  },
  "infrastructure": {
    "supabase": {
      "urlEnv": "NEXT_PUBLIC_SUPABASE_URL",
      "publishableKeyEnv": "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
      "secretKeyEnv": "SUPABASE_SECRET_KEY"
    },
    "storage": {
      "provider": "supabase_storage",
      "bucketEnv": "SUPABASE_STORAGE_BUCKET"
    }
  },
  "release": {
    "channel": "stable"
  }
}
