        "divisions": [
          "DIV-A",
          "DIV-B",
          "DIV-C",
          "DIV-D",
          "DIV-E"
        ]
      }
    },
    {
      "id": "MS-QA-AR-001",
      "version": "1.0.0",
      "file": "receivables-synthetic.csv",
      "format": "csv",
      "records": 6,
      "sha256": null,
